{
  "format": "fpgacapzero.probes.v1",
  "core": "ela",
  "sample_width": 100,
  "probes": [
    {"name": "done",       "width": 1,  "lsb": 0},
    {"name": "write",      "width": 1,  "lsb": 1},
    {"name": "pin_clk",    "width": 1,  "lsb": 2},
    {"name": "pin_wr",     "width": 1,  "lsb": 3},
    {"name": "pin_data",   "width": 16, "lsb": 4},
    {"name": "addr",       "width": 32, "lsb": 20},
    {"name": "data",       "width": 32, "lsb": 52},
    {"name": "user_probe", "width": 16, "lsb": 84}
  ]
}
